PORT=4000
WEB_ORIGIN=http://localhost:3000
# Путь к файловому хранилищу — по умолчанию внутри проекта
# (apps/server/storage), не где-то в системе вроде /var/data/...
# Относительный путь резолвится от расположения apps/server, а не от
# текущей директории запуска — можно указать и абсолютный путь (например,
# смонтированный диск в проде), тогда он используется как есть.
STORAGE_ROOT=./storage

# Сетка спрайт-листов для наборов тайлов ярлыка страницы (storageRoot/
# tile-sets/<название>.png — см. install.md, раздел «Свои наборы тайлов»).
# Не действует на второй вид набора — папку с уже нарезанными отдельными
# файлами: там своей сетки нет, каждый файл сам по себе тайл вне
# зависимости от размера. Раскомментируй и поменяй, если твои спрайт-листы
# нарезаны на другую сетку — например, 4×4 по 128×128 вместо стандартных
# 4×5 по 64×64.
#TILE_SHEET_COLS=4
#TILE_SHEET_ROWS=5
#TILE_SIZE=64

ACCESS_TOKEN_SECRET=change-me-32-chars-minimum-please
REFRESH_TOKEN_SECRET=change-me-different-32-chars-minimum

# Учётные данные первого администратора. При старте сервер создаёт этого
# пользователя автоматически, если в хранилище ещё нет ни одного аккаунта
# (см. seedAdminFromEnv в src/routes/auth.routes.ts). После первого успешного
# запуска эти переменные можно оставить как есть — повторно они не
# используются, пока хранилище не очищено.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_DISPLAY_NAME=Администратор

# Свой STUN/TURN-сервер (coturn) для видеозвонков — см. install.md,
# раздел «Видеозвонки», и deploy/turnserver.conf. Без этих переменных
# звонки работают только между людьми в одной сети или с публичными IP —
# GET /api/webrtc/ice-servers отдаст пустой список вместо того, чтобы
# молча подставить чей-то чужой публичный STUN/TURN.
# TURN_SECRET должен буквально совпадать со static-auth-secret в
# turnserver.conf — это общий секрет для проверки временных креды.
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Какие типы файлов можно прикреплять в чате (не влияет на личное
# файловое хранилище /files — там ограничений нет). Через запятую,
# поддерживает wildcard вида image/*. Если не задано — используется
# разумный дефолт (картинки, видео, PDF, текст, офисные форматы, zip).
# CHAT_ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,text/plain
