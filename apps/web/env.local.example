# Port the Next.js dev/start server binds to.
# IMPORTANT: Next.js's CLI does not read PORT from .env files on its own —
# apps/web/scripts/run.mjs (used by `npm run dev` / `npm run start`) loads
# this file and passes -p explicitly. See install.md "Порты" section.
PORT=3000

# Where the browser sends API requests. Must match apps/server's PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Logo height in pixels — login screen (larger, shown once) and header
# (smaller, shown in every sidebar row). Optional — falls back to 64/32
# if unset or not a positive number. Like every NEXT_PUBLIC_* var, baked
# in at build time: a `next build` deployment needs a rebuild for a
# change here to take effect, `next dev` picks it up on the next restart.
NEXT_PUBLIC_LOGIN_LOGO_HEIGHT=64
NEXT_PUBLIC_HEADER_LOGO_HEIGHT=32
